{
  "expo": {
    "name": "CollegeMatch",
    "slug": "collegematch",
    "owner": "jack.myaibot",
    "scheme": "collegematch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.collegematch.app"
    },
    "android": {
      "package": "com.collegematch.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C3B2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "CollegeMatch",
      "shortName": "CollegeMatch",
      "themeColor": "#0C3B2C",
      "backgroundColor": "#F3F0E8",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "barStyle": "default"
    },
    "extra": {
      "eas": {
        "projectId": "40f835a6-bb9c-49be-80ce-9130f9b72f6f"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
